# Copy to frontend/.env.local and fill in. Never commit frontend/.env.local.

# Where the Express API runs. Next.js forwards /api/* to it, so the browser
# only ever talks to the frontend's own origin.
API_URL=http://localhost:8080

# Google Maps JavaScript API key (Maps + Places). Leave empty to run without a
# map: results show as a list and destinations come from a built-in list.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
