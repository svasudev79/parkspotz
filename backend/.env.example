# Copy to backend/.env and fill in. Never commit backend/.env.
PORT=8080

# Local Postgres. The default below matches the repo-local cluster described in
# the README; change user/password/port to match your own Postgres if you use one.
DATABASE_URL=postgres://parkspotz@127.0.0.1:5433/parkspotz

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Only needed on Cloud Run with the Cloud SQL Unix socket:
# INSTANCE_CONNECTION_NAME=project:region:instance

# Minutes an unpaid (pending) booking keeps its slot before the slot is released.
BOOKING_HOLD_MINUTES=10

# Public address of the frontend. Receipt QR codes link to <APP_BASE_URL>/verify/<token>.
APP_BASE_URL=http://localhost:3000

# Payments. "mock" shows an in-app test payment screen and needs no keys.
# "razorpay" uses Razorpay Checkout and needs both keys below (use TEST keys).
# If PAYMENT_MODE is left empty, razorpay is used only when both keys are set.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Gate: entry can be recorded from this many minutes before a booking starts.
ENTRY_GRACE_MINUTES=15

# Overstay charge, collected by the attendant at exit. The first
# OVERSTAY_GRACE_MINUTES after the booked end are free. Beyond that, the whole
# overstay is billed from the booked end in started blocks of
# OVERSTAY_BLOCK_MINUTES, at OVERSTAY_RATE_PERCENT % of the space's hourly price.
# Defaults: at 40/hour, leaving 50 minutes late costs 2 blocks = 40.
OVERSTAY_GRACE_MINUTES=10
OVERSTAY_BLOCK_MINUTES=30
OVERSTAY_RATE_PERCENT=100

# Folder where entry photos are stored (default: backend/uploads, ignored by git).
# UPLOADS_DIR=uploads

# Monthly rental invoices fall due on this day of the month (1-28).
RENTAL_DUE_DAY=7

# The platform admin login (the person who runs ParkSpotZ). It is created or
# updated only by `npm run admin:create`, which reads these two values.
# Use a long random password (at least 12 characters) and keep it private.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
