{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:setup": "tsx src/scripts/db-setup.ts",
    "db:start": "/Applications/Postgres.app/Contents/Versions/latest/bin/pg_ctl -D ../.localdb/data -l ../.localdb/postgres.log -w start",
    "db:stop": "/Applications/Postgres.app/Contents/Versions/latest/bin/pg_ctl -D ../.localdb/data stop",
    "db:seed": "tsx src/scripts/db-seed.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "admin:create": "tsx src/scripts/admin-create.ts",
    "rental:generate": "tsx src/scripts/rental-generate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
