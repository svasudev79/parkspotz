.DS_Store
# repo-local Postgres data directory (see README)
.localdb/

# Secrets and deployment settings never belong in git. The .env.example files
# (placeholders only) are the exception.
.env
.env.*
*.env
!.env.example
deploy/secrets*

# Walkthrough videos are large; only demo/README.md is tracked.
demo/*.webm
demo/*.mp4
demo/.tmp/

# Account recovery codes and similar must never be committed
recovery-codes*
*recovery*codes*
